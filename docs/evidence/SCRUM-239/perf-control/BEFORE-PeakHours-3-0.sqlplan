<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.1000.6"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH Source AS (&#xd;&#xa; SELECT DATEPART(HOUR,DATEADD(HOUR,7,o.CreatedAt)) HourOfDay,&#xd;&#xa; CASE ((DATEDIFF(DAY,CONVERT(DATE,&apos;19000101&apos;),CONVERT(DATE,DATEADD(HOUR,7,o.CreatedAt)))%7+7)%7)&#xd;&#xa; WHEN 0 THEN N&apos;T2&apos; WHEN 1 THEN N&apos;T3&apos; WHEN 2 THEN N&apos;T4&apos; WHEN 3 THEN N&apos;T5&apos; WHEN 4 THEN N&apos;T6&apos; WHEN 5 THEN N&apos;T7&apos; ELSE N&apos;CN&apos; END DayLabel,&#xd;&#xa; 1 Cnt FROM sales.[Order] o WHERE o.Status IN(N&apos;PAID&apos;,N&apos;DISPENSED&apos;)&#xd;&#xa; AND o.CreatedAt&gt;=DATEADD(HOUR,-7,CONVERT(DATETIME2,@From)) AND o.CreatedAt&lt;DATEADD(HOUR,17,CONVERT(DATETIME2,@To))&#xd;&#xa; ), Pivoted AS (SELECT * FROM Source PIVOT(SUM(Cnt) FOR DayLabel IN([T2],[T3],[T4],[T5],[T6],[T7],[CN])) p)&#xd;&#xa; SELECT g.value HourOfDay,COALESCE(T2,0) T2,COALESCE(T3,0) T3,COALESCE(T4,0) T4,COALESCE(T5,0) T5,&#xd;&#xa; COALESCE(T6,0) T6,COALESCE(T7,0) T7,COALESCE(CN,0) CN,&#xd;&#xa; COALESCE(T2,0)+COALESCE(T3,0)+COALESCE(T4,0)+COALESCE(T5,0)+COALESCE(T6,0)+COALESCE(T7,0)+COALESCE(CN,0) Total&#xd;&#xa; FROM GENERATE_SERIES(0,23) g LEFT JOIN Pivoted p ON p.HourOfDay=g.value ORDER BY g.value" StatementId="4" StatementCompId="78" StatementType="SELECT" StatementSqlHandle="0x090078C7343DF641127509A58CE2271841720000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="4" ParentObjectId="1195151303" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.00925316" StatementEstRows="24" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x7BE2F76662527F06" QueryPlanHash="0xD082821EB78AF6B7" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="tru