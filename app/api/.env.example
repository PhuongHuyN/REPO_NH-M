# =====================================================================
#  FreshVend API – cấu hình. Sao chép thành file .env (KHÔNG đưa .env lên Git).
#    Windows:  copy .env.example .env
# =====================================================================
PORT=3000

# ---------- Chế độ cơ sở dữ liệu ----------
# demo      : CHƯA cần SQL Server – dùng dữ liệu giả lập trong bộ nhớ (đang làm FE, chạy thử, quay video demo)
# sqlserver : kết nối SQL Server thật (sau khi chạy FreshVend_FULL.sql trong SSMS và điền các mục DB_* bên dưới)
DB_MODE=demo

# ---------- Kết nối SQL Server (dùng khi đã tạo CSDL bằng FreshVend_Database) ----------
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=FreshVendDB
DB_ENCRYPT=false
DB_TRUST_CERT=true
# Dùng instance có tên (vd. SQLEXPRESS): đặt DB_INSTANCE=SQLEXPRESS và để trống DB_PORT
DB_INSTANCE=

# Mỗi vai trò dùng một login SQL riêng, tạo trong FreshVend_Database/26_security.sql.
# Mật khẩu ở đây phải TRÙNG với mật khẩu trong file đó.
DB_ADMIN_USER=fv_admin_app
DB_ADMIN_PASSWORD=FreshVend@Admin2026
DB_OPERATOR_USER=fv_operator_app
DB_OPERATOR_PASSWORD=FreshVend@Operator2026
DB_KIOSK_USER=fv_kiosk_app
DB_KIOSK_PASSWORD=FreshVend@Kiosk2026
DB_DEVICE_USER=fv_device_app
DB_DEVICE_PASSWORD=FreshVend@Device2026

# ---------- Bảo mật (đổi các chuỗi bí mật này) ----------
JWT_SECRET=hay-doi-chuoi-bi-mat-nay
JWT_EXPIRES_HOURS=8
# Phiên của màn hình kiosk (giờ) – mặc định 30 ngày
KIOSK_SESSION_HOURS=720
DEVICE_API_KEY=hay-doi-khoa-thiet-bi-nay
PAYMENT_WEBHOOK_SECRET=hay-doi-khoa-webhook-nay

# ---------- Tài khoản nhận tiền (mã VietQR hiện trên kiosk) ----------
# Mã BIN ngân hàng (NAPAS): Vietcombank 970436, VietinBank 970415, BIDV 970418, Agribank 970405,
# Techcombank 970407, MB 970422, ACB 970416, VPBank 970432, TPBank 970423, Sacombank 970403
PAYMENT_BANK_BIN=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=
# Khóa API webhook của SePay (my.sepay.vn -> Webhooks -> Xác thực: API Key).
# URL webhook khai báo: https://<ten-mien>/api/payments/sepay-webhook
SEPAY_API_KEY=
# Số hotline hỗ trợ khách hàng, hiện trên màn hình kiosk
SUPPORT_PHONE=

# Bật khi SQL Server không có SQL Server Agent (bản Express / LocalDB)
JOBS_FALLBACK=false
